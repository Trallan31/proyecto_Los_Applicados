{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Applicate con Express, TypeScript y Mongoose.",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "test": "cross-env NODE_ENV=test tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test-only": "cross-env NODE_ENV=test tsx --test-only --test-concurrency=1 \"tests/**/*.test.ts\"",
    "start:test": "cross-env NODE_ENV=test tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "create-user": "tsx src/createUser.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.2"
  }
}
